# 服务器只运行应用容器。PostgreSQL 由外部环境提供，不在 Compose 中创建。
# 镜像必须已推送到服务器可访问的仓库，或提前通过 docker load 导入服务器。
WELL_AMBIENT_SERVER_IMAGE=registry.example.com/your-team/well-ambient-server
WELL_AMBIENT_WEB_IMAGE=registry.example.com/your-team/well-ambient-web
WELL_AMBIENT_VERSION=2026.08.26-1
# 浏览器首次安装的高熵一次性令牌，至少 32 个字符。安装成功后接口会自动关闭。
WELL_AMBIENT_SETUP_TOKEN=replace-with-a-separate-long-random-setup-token
# 直接运行 docker compose 时需要与 deploy/runtime 的宿主机所有者一致。
APP_UID=1000
APP_GID=1000
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
TZ=Asia/Shanghai
