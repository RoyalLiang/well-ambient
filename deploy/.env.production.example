# 服务器只运行应用容器。PostgreSQL 由外部环境提供，不在 Compose 中创建。
# 镜像必须已推送到服务器可访问的仓库，或提前通过 docker load 导入服务器。
WELL_AMBIENT_SERVER_IMAGE=registry.example.com/your-team/well-ambient-server
WELL_AMBIENT_WEB_IMAGE=registry.example.com/your-team/well-ambient-web
# 版本、构建日期和批次说明由 make release / make deploy 自动生成，勿在这里重复维护。
# 可留空，让程序在首次安装模式生成一次性令牌；也可填写至少 32 个字符的高熵值。
WELL_AMBIENT_SETUP_TOKEN=
# 直接运行 docker compose 时需要与 deploy/runtime 的宿主机所有者一致。
APP_UID=1000
APP_GID=1000
# 紧急强制开启覆盖：WellOS 维护且登录返回 10002 时可临时设为 1。
# 正常状态由配置中心写入数据库；完成切换后应清空该值并重建 server。
WELL_AMBIENT_MAINTENANCE_MODE=
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
TZ=Asia/Shanghai
