# 目标应用库；内置 PostgreSQL 首次只创建维护库 postgres，目标库由安装页创建。
POSTGRES_DB=well_ambient
POSTGRES_USER=well_ambient
# URL-safe characters only because this value is embedded in the application DSN.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
# 浏览器首次安装的高熵一次性令牌，至少 32 个字符。安装成功后接口会自动关闭。
WELL_AMBIENT_SETUP_TOKEN=replace-with-a-separate-long-random-setup-token
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
TZ=Asia/Shanghai
